38590>>>                Case Break
38591>>>
38591>>>            Case Else // must be nfUndefined
38591>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38591>>>
38591>>>        Case End
38591>>>
38591>>>    End_Procedure
