38133>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38136>>>        Case Begin
38136>>>            Case (NavigateData.eNavigateType = nfFromMain)
38138>>>                // If from main, this is a propbably a main file Select to Zoom.
38138>>>                Case Break
38139>>>
38139>>>            Case (NavigateData.eNavigateType = nfFromParent)
38142>>>                // If from parent, this is a constrained drill down.
38142>>>                Case Break
38143>>>
38143>>>            Case (NavigateData.eNavigateType = nfFromChild)
38146>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38146>>>                Case Break
38147>>>
38147>>>            Case Else // must be nfUndefined
38147>>>
38147>>>        Case End
38147>>>
38147>>>        Send SetActionButtons
38148>>>
38148>>>    End_Procedure
38149>>>
