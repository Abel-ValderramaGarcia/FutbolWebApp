37653>>>    // Muestra/oculta los botones según haya registro y modo edición/lectura.
37653>>>    Procedure SetActionButtons
37656>>>        tWebNavigateData NavigateData
37656>>>        tWebNavigateData NavigateData
37656>>>        Boolean bHasRecord
37656>>>        Handle hoDD
37656>>>
37656>>>        Get Server           to hoDD
37657>>>        Get GetNavigateData  to NavigateData
37658>>>        Get HasRecord of hoDD to bHasRecord
37659>>>
37659>>>        // Ocultamos todos los botones y luego mostramos sólo los que tocan.
37659>>>        WebSet pbRender of oEditBtn          to False
37660>>>        WebSet pbRender of oSaveBtn          to False
37661>>>        WebSet pbRender of oCancelChangesBtn to False
37662>>>        WebSet pbRender of oDeleteBtn        to False
37663>>>
37663>>>        If (NavigateData.bReadOnly) Begin
37665>>>            WebSet pbRender of oEditBtn to True
37666>>>        End
37666>>>>
37666>>>        Else Begin
37667>>>            WebSet pbRender of oSaveBtn          to True
37668>>>            WebSet pbRender of oCancelChangesBtn to True
37669>>>            WebSet pbRender of oDeleteBtn        to bHasRecord
37670>>>        End
37670>>>>
37670>>>    End_Procedure
