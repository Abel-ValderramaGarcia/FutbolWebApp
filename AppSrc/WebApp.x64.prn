37681>>>    // Se ejecuta al navegar a esta vista (por ejemplo, desde SelectLiga).
37681>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37684>>>
37684>>>        Case Begin
37684>>>            Case (NavigateData.eNavigateType = nfFromMain)
37686>>>                // Venimos desde el Select de ligas (drilldown principal).
37686>>>                Case Break
37687>>>
37687>>>            Case (NavigateData.eNavigateType = nfFromParent)
37690>>>                // Navegación desde otro padre (no habitual aquí).
37690>>>                Case Break
37691>>>
37691>>>            Case (NavigateData.eNavigateType = nfFromChild)
37694>>>                // Navegación desde un hijo hacia el padre.
37694>>>                Case Break
37695>>>
37695>>>            Case Else // nfUndefined
37695>>>        Case End
37695>>>
37695>>>        // No hace falta hacer nada más para los equipos:
37695>>>        // Constrain_File ya deja oequipo_DD filtrado por la liga actual.
37695>>>        Send SetActionButtons
37696>>>    End_Procedure
