37783>>>>>
37783>>>>>            Case Begin
37783>>>>>                Case (NavigateData.eNavigateType = nfFromParent)
37785>>>>>                    // From parent: aún no se ha definido navegación específica
37785>>>>>                    // hacia otra Select hija desde este SelectLiga.
37785>>>>>                    Case Break
37786>>>>>
37786>>>>>                Case (NavigateData.eNavigateType = nfFromChild)
37789>>>>>                    // From child: este SelectLiga se ha abierto como "Select padre"
37789>>>>>                    // desde un Zoom hijo. Al hacer click cerramos el Select y
37789>>>>>                    // devolvemos el foco al Zoom que lo invocó.
37789>>>>>                    Send NavigateClose Self
37790>>>>>                    Case Break
37791>>>>>
37791>>>>>                Case (NavigateData.eNavigateType = nfFromMain)
37794>>>>>                    // From main: este SelectLiga se ha abierto desde el menú principal.
37794>>>>>                    // En este caso, al hacer click solo cerramos el Select y
37794>>>>>                    // volvemos a la vista que abrió la navegación (InvokingObject),
37794>>>>>                    Send NavigateClose Self
37795>>>>>                    Case Break
37796>>>>>
37796>>>>>                Case Else // must be nfUndefined
37796>>>>>                    // Undefined: no hay flujo especial definido, dejamos el caso
37796>>>>>                    // de ejemplo sin implementar explícito.
37796>>>>>                    Case Break
37797>>>>>            Case End
37797>>>>>        End_Procedure
