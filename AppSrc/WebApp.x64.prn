38112>>>        WebSet pbRender of oSaveBtn to False
38113>>>        WebSet pbRender of oCancelChangesBtn to False
38114>>>        WebSet pbRender of oDeleteBtn to False
38115>>>
38115>>>        If (NavigateData.bReadOnly) Begin
38117>>>            WebSet pbRender of oEditBtn to True
38118>>>        End
38118>>>>
38118>>>        Else Begin
38119>>>            WebSet pbRender of oSaveBtn to True
38120>>>            WebSet pbRender of oCancelChangesBtn to True
38121>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38122>>>        End
38122>>>>
38122>>>    End_Procedure
38123>>>
