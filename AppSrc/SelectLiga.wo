// C:\DataFlex Projects\FutbolWebApp\AppSrc\SelectLiga.wo
// SelectLiga
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg
Use ZoomLiga.wo

Use cligaDataDictionary.dd

Object oSelectLiga is a cWebView
    Set psCaption       to "SelectLiga"
    Set peWebViewStyle  to wvsDrilldown
    Set peViewType      to vtSelect
    Set piColumnCount   to 12
    Set pbShowCaption   to False
    Set piMaxWidth      to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object

    Set Main_DD to oliga_DD
    Set Server  to oliga_DD


    Object oList is a cWebList
        Set piColumnSpan       to 0
        Set psCSSClass         to "MobileList"
        Set pbServerOnRowClick to True
        Set pbFillHeight       to True
        Set pbShowHeader       to False
        Set piSortColumn       to 0

        Object oligaID is a cWebColumn
            Entry_Item liga.ID
            Set psCaption to "liga.ID"
            Set piWidth   to 100
        End_Object

        Object oDetailButton is a cWebColumnButton
            Set psCaption      to "btn"
            Set piWidth        to 45
            Set pbFixedWidth   to True
            Set pbResizable    to False
            Set piListRowSpan  to 5
            Set psBtnCssClass  to "WebButtonIcon WebIcon_Info"
            Set peAlign        to alignRight

            WebRegisterPath ntNavigateForward oZoomLiga

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bReadOnly
            End_Procedure

        End_Object

        Object oligaNombre is a cWebColumn
            Entry_Item liga.Nombre
            Set psCaption to "liga.Nombre"
            Set piWidth   to 1000
            Set pbNewLine to True
        End_Object

        Object oligaPais is a cWebColumn
            Entry_Item liga.Pais
            Set psCaption to "liga.Pais"
            Set piWidth   to 500
            Set pbNewLine to True
        End_Object

        Object oligaEquipos is a cWebColumn
            Entry_Item liga.Equipos
            Set psCaption to "liga.Equipos"
            Set piWidth   to 100
            Set pbNewLine to True
        End_Object

        Object oligaEquiposMax is a cWebColumn
            Entry_Item liga.EquiposMax
            Set psCaption to "liga.EquiposMax"
            Set piWidth   to 100
            Set pbNewLine to True
        End_Object

        // APARTADO 2: From child -> Zoom hijo - Select padre.
        // Este SelectLiga se usará también como "Select padre" cuando se llame
        // desde un Zoom hijo (por ejemplo, ZoomEquipo). En ese caso la navegación
        // nfFromChild cerrará esta vista al hacer click en una fila y devolverá
        // el control al Zoom que la abrió. [web:916][web:919]

        Procedure OnRowClick String sRowId
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType = nfFromParent)
                    // From parent: aún no se ha definido navegación específica
                    // hacia otra Select hija desde este SelectLiga.
                    Case Break

                Case (NavigateData.eNavigateType = nfFromChild)
                    // From child: este SelectLiga se ha abierto como "Select padre"
                    // desde un Zoom hijo. Al hacer click cerramos el Select y
                    // devolvemos el foco al Zoom que lo invocó.
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromMain)
                    // From main: este SelectLiga se ha abierto desde el menú principal.
                    // En este caso, al hacer click solo cerramos el Select y
                    // volvemos a la vista que abrió la navegación (InvokingObject),
                    Send NavigateClose Self
                    Case Break

                Case Else // must be nfUndefined
                    // Undefined: no hay flujo especial definido, dejamos el caso
                    // de ejemplo sin implementar explícito.
                    Case Break
            Case End
        End_Procedure

        // Navegación forward desde la fila al ZoomLiga mediante el botón "btn".
        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            Move True to NavigateData.bReadOnly
        End_Procedure

    End_Object

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption  to "Search"

            Procedure OnClick
                Send Search of oList
            End_Procedure
        End_Object

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption  to "New"

            WebRegisterPath ntNavigateForward oZoomLiga

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
            End_Procedure
        End_Object
    End_Object

    // APARTADO 1: From main -> Select-Zoom, ¿qué pasa con InvokingObject?
    //
    // - Si venimos desde el main (nfFromMain), InvokingObject es la vista que
    //   inició la navegación (por ejemplo, el Dashboard o un menú). [web:916]
    // - Este SelectLiga se comporta como una lista de selección: muestra el
    //   botón de detalle (oDetailButton) que navega al ZoomLiga. [web:919]
    // - En otros casos (nfFromChild, nfFromParent) este mismo Select se
    //   reutiliza como "Select padre" o "Select hijo" y se ajusta qué botones
    //   se muestran. Así, InvokingObject indica QUIÉN abrió la vista, pero
    //   normalmente no hace falta usarlo directamente aquí: basta con
    //   eNavigateType para saber el flujo. [web:916][web:919]

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        WebSet pbRender of oNewButton   to True
        WebSet pbRender of oDetailButton to True

        Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                // From parent: SelectLiga se usa como Select hijo de otra vista.
                // Mostramos botón detalle y botón New normales.
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // From child: SelectLiga actúa como "Select padre" para un Zoom.
                // En este escenario lo habitual es solo seleccionar un registro y
                // cerrar, por eso mantenemos los botones estándar. [web:916]
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                // From main: se ha abierto desde el main (InvokingObject es el main).
                // En este caso ocultamos el botón de detalle de la lista y dejamos
                // que se use la navegación típica de Select principal. [web:916]
                WebSet pbRender of oDetailButton to False
                Case Break

            Case Else // must be nfUndefined
                // Undefined: uso libre para consultas personalizadas.
        Case End
    End_Procedure

End_Object